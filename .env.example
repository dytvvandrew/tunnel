# Tunnel smart-control platform
APP_HOST=0.0.0.0
APP_PORT=8010
ADMIN_USERNAME=123
ADMIN_PASSWORD=123456

# OpenAI-compatible chat endpoint.
# Local Qwen/vLLM example:
BRAIN_PROVIDER=local-vllm
BRAIN_API_BASE=http://127.0.0.1:18021/v1
BRAIN_MODEL=qwen2.5-7b
BRAIN_API_KEY=

# Commercial API example:
# BRAIN_PROVIDER=commercial-api
# BRAIN_API_BASE=https://api.example.com/v1
# BRAIN_MODEL=your-chat-model
# BRAIN_API_KEY=YOUR_API_KEY_HERE

BRAIN_TIMEOUT_SECONDS=45
BRAIN_MAX_TOKENS=768

# Optional cross-origin access for the GitHub Pages AI assistant.
# Keep this empty unless you explicitly want the public page to reach this server.
# Use HTTPS on the server when browser credentials are required.
TUNNEL_CORS_ORIGINS=https://dytvvandrew.github.io
TUNNEL_CROSS_SITE_COOKIES=1

# RAG retrieval is local and can be used with either local Qwen or a paid API.
BRAIN_RAG_ENABLED=1
BRAIN_RAG_TOP_K=4
BRAIN_RAG_CONTEXT_CHARS=3000

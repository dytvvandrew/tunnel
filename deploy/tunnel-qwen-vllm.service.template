[Unit]
Description=Local Qwen vLLM Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=csuvla
WorkingDirectory=/home/csuvla/dyt/tunnel-platform
Environment=CUDA_VISIBLE_DEVICES=0
Environment=MODEL_PATH=/path/to/Qwen2.5-7B-Instruct
Environment=PORT=18021
ExecStart=/bin/bash -lc 'python -m vllm.entrypoints.openai.api_server --model "$MODEL_PATH" --served-model-name qwen2.5-7b --host 0.0.0.0 --port "$PORT"'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

